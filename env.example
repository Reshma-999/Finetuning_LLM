# ── Model ─────────────────────────────────────────────────────────────────────
MODEL_PATH=./models/mistral-finance-v1-merged
HF_TOKEN=hf_...                    # HuggingFace token for downloading Mistral

# ── Inference ─────────────────────────────────────────────────────────────────
USE_VLLM=true
GPU_MEMORY_UTILIZATION=0.85
MAX_NEW_TOKENS=512
TEMPERATURE=0.1
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# ── Training ──────────────────────────────────────────────────────────────────
WANDB_API_KEY=...

# ── Evaluation ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...              # For GPT-3.5 baseline comparison

# ── Azure Blob ─────────────────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
AZURE_STORAGE_ACCOUNT=financialllm
AZURE_CONTAINER_NAME=financial-llm

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_LAMBDA_FUNCTION_NAME=financial-summarizer
ECR_REPOSITORY=financial-llm-inference
